# Database Configuration (Mandatory)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gmail_tracker?schema=public"

# NestJS Server Configuration (Mandatory)
PORT=4000
API_URL="http://localhost:4000"
API_PUBLIC_URL="http://localhost:4000" # Must be reachable by tracking pixels (e.g. ngrok tunnel in dev)

# NextJS Frontend Configuration (Mandatory)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_API_PUBLIC_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Mandatory)
# Retrieve from Google Cloud Console under API Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Session & Token Encryption Keys (Mandatory)
# SESSION_SECRET must be at least 16 characters long and secure
SESSION_SECRET="your-super-secret-jwt-session-key-must-be-secure"
# GOOGLE_TOKEN_ENCRYPTION_KEY must be a 64-character hex string representing a 32-byte key
GOOGLE_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS Configuration (Mandatory)
CORS_ORIGIN="http://localhost:3000"
