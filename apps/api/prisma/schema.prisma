datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RecipientType {
  TO
  CC
  BCC
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum TrackingEventType {
  OPEN
  CLICK
}

enum OpenCategory {
  RECIPIENT_OPEN
  SELF_OPEN
  UNKNOWN_OPEN
}

model User {
  id           String         @id @default(uuid())
  googleId     String         @unique
  email        String         @unique
  name         String
  picture      String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  accounts     GmailAccount[]
  threads      TrackedThread[]
}

model GmailAccount {
  id           String         @id @default(uuid())
  userId       String
  email        String
  accessToken  String         // Encrypted
  refreshToken String         // Encrypted
  tokenExpiry  DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
}

model TrackedThread {
  id             String           @id @default(uuid())
  userId         String
  gmailThreadId  String           @unique
  subject        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       TrackedMessage[]

  @@index([userId])
  @@index([createdAt])
}

model TrackedMessage {
  id               String             @id @default(uuid())
  trackedThreadId  String
  gmailMessageId   String             @unique
  gmailThreadId    String
  messageIdHeader  String
  direction        MessageDirection
  subject          String
  sentAt           DateTime
  createdAt        DateTime           @default(now())

  trackedThread    TrackedThread      @relation(fields: [trackedThreadId], references: [id], onDelete: Cascade)
  recipients       TrackedRecipient[]

  @@index([gmailThreadId])
  @@index([createdAt])
}

model TrackedRecipient {
  id               String            @id @default(uuid())
  trackedMessageId String
  email            String
  displayName      String?
  recipientType    RecipientType
  trackingToken    String            @unique
  firstOpenedAt    DateTime?
  lastOpenedAt     DateTime?
  openCount        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  trackedMessage   TrackedMessage    @relation(fields: [trackedMessageId], references: [id], onDelete: Cascade)
  events           TrackingEvent[]

  @@index([trackingToken])
  @@index([email])
  @@index([createdAt])
}

model TrackingEvent {
  id                 String            @id @default(uuid())
  trackedRecipientId String
  type               TrackingEventType
  category           OpenCategory
  timestamp          DateTime          @default(now())
  userAgent          String?
  ipHash             String?
  referer            String?
  createdAt          DateTime          @default(now())

  trackedRecipient   TrackedRecipient  @relation(fields: [trackedRecipientId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
